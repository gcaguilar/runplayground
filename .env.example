# ---------------------------------------------------------------------------
# Run — configuration
#
# Copy this file to .env before starting the container:
#     cp .env.example .env
#
# Every value below can stay commented out; the defaults are shown.
# ---------------------------------------------------------------------------

# --- Garmin Personal API ---------------------------------------------------
# Create a personal API key in Garmin Connect and paste it here.
# Access is requested through the Garmin Connect developer program:
# https://developer.garmin.com/gc-developer-program/
# Leave empty to use the dashboard only with manual FIT/TCX/GPX imports.
GARMIN_PERSONAL_API_KEY=

# --- Access protection (optional) ------------------------------------------
# "none"     No login. The container is published on 127.0.0.1 by default.
# "password" Single password login. Requires APP_PASSWORD and SECRET_KEY.
AUTH_MODE=none

# APP_PASSWORD=choose-a-strong-password
# SECRET_KEY=at-least-16-random-characters
# SESSION_DAYS=30

# --- Synchronisation -------------------------------------------------------
# How often to poll Garmin, in hours. 0 disables automatic sync.
# SYNC_INTERVAL_HOURS=12
# Download the original FIT file for every activity (recommended).
# SYNC_DOWNLOAD_FIT=true
# Run a sync when the application starts.
# SYNC_ON_STARTUP=false
# SYNC_INCREMENTAL_MAX_PAGES=3
# SYNC_BACKFILL_MAX_PAGES=100
# SYNC_REQUEST_DELAY_SECONDS=0.2

# --- Application -----------------------------------------------------------
# APP_NAME=Run
# LOG_LEVEL=INFO
# Maximum size of a single uploaded file, in MB.
# MAX_UPLOAD_MB=50
# Maximum size of a Garmin bulk-export ZIP, in MB.
# GARMIN_EXPORT_MAX_MB=500
# Maximum uncompressed size of a generated backup, in MB.
# MAX_BACKUP_MB=4096
# Maximum compressed and uncompressed size of an uploaded restore, in MB.
# MAX_RESTORE_MB=1024
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
